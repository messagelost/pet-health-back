<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jacob.dao.mappers.user.SysUserNotifySettingDao">

    <!-- 基础结果映射：对应UserNotifySetting实体类所有字段 -->
    <resultMap id="BaseResultMap" type="com.jacob.common.model.user.entity.SysUserNotifySetting">
        <id property="settingId" column="setting_id"/>
        <result property="userId" column="user_id"/>
        <result property="channel" column="channel"/>
        <result property="enabled" column="enabled"/>
        <!-- 继承BaseEntity的公共字段 -->
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="updateUserId" column="update_user_id"/>
    </resultMap>

    <!-- 基础字段列表：用于查询语句复用 -->
    <sql id="Base_Column_List">
        uns.setting_id,
        uns.user_id,
        uns.channel,
        uns.enabled,
        uns.create_time,
        uns.update_time,
        uns.create_user_id,
        uns.update_user_id
    </sql>

    <!-- 新增用户通知配置 -->
    <insert id="insertWithBean" parameterType="com.jacob.common.model.user.entity.SysUserNotifySetting">
        INSERT INTO user_notify_setting
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="settingId != null and settingId != ''">
                setting_id,
            </if>
            <if test="userId != null and userId != ''">
                user_id,
            </if>
            <if test="channel != null and channel != ''">
                channel,
            </if>
            <if test="enabled != null">
                enabled,
            </if>
            create_time,
            update_time,
            <if test="createUserId != null and createUserId != ''">
                create_user_id,
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                update_user_id,
            </if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="settingId != null and settingId != ''">
                #{settingId},
            </if>
            <if test="userId != null and userId != ''">
                #{userId},
            </if>
            <if test="channel != null and channel != ''">
                #{channel},
            </if>
            <if test="enabled != null">
                #{enabled},
            </if>
            NOW(),
            NOW(),
            <if test="createUserId != null and createUserId != ''">
                #{createUserId},
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                #{updateUserId},
            </if>
        </trim>
    </insert>

    <!-- 更新用户通知配置 -->
    <update id="updateWithBean" parameterType="com.jacob.common.model.user.entity.SysUserNotifySetting">
        UPDATE user_notify_setting
        <set>
            <if test="userId != null and userId != ''">user_id = #{userId},</if>
            <if test="channel != null and channel != ''">channel = #{channel},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            update_time = NOW(),
            <if test="updateUserId != null and updateUserId != ''">update_user_id = #{updateUserId},</if>
        </set>
        WHERE setting_id = #{settingId}
    </update>

    <!-- 更新用户渠道启用状态（高频操作专用） -->
    <update id="updateEnabledStatus" parameterType="java.util.Map">
        UPDATE user_notify_setting
        SET enabled = #{enabled},
            update_time = NOW(),
            update_user_id = #{updateUserId}
        WHERE user_id = #{userId}
          AND channel = #{channel}
    </update>

    <!-- 根据主键删除用户通知配置 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.String">
        DELETE FROM user_notify_setting WHERE setting_id = #{settingId}
    </delete>

    <!-- 批量删除用户通知配置 -->
    <delete id="deleteBatchByPrimaryKeys" parameterType="java.lang.String">
        DELETE FROM user_notify_setting
        WHERE setting_id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 统计用户通知配置数量（带条件） -->
    <select id="getCount" resultType="java.lang.Integer" parameterType="java.util.Map">
        SELECT COUNT(1)
        FROM user_notify_setting uns
        <where>
            <if test="settingId != null and settingId != ''">
                AND uns.setting_id = #{settingId}
            </if>
            <if test="userId != null and userId != ''">
                AND uns.user_id = #{userId}
            </if>
            <if test="channel != null and channel != ''">
                AND uns.channel = #{channel}
            </if>
            <if test="enabled != null">
                AND uns.enabled = #{enabled}
            </if>
        </where>
    </select>

    <!-- 查询用户通知配置列表（带条件） -->
    <select id="selectAllList" resultMap="BaseResultMap" parameterType="java.util.Map">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_notify_setting uns
        <where>
            <if test="settingId != null and settingId != ''">
                AND uns.setting_id = #{settingId}
            </if>
            <if test="userId != null and userId != ''">
                AND uns.user_id = #{userId}
            </if>
            <if test="channel != null and channel != ''">
                AND uns.channel = #{channel}
            </if>
            <if test="enabled != null">
                AND uns.enabled = #{enabled}
            </if>
        </where>
        <if test="custom_order_by != null and custom_order_by != ''">
            ORDER BY ${custom_order_by}
        </if>
        <!-- 默认按创建时间降序 -->
        <if test="custom_order_by == null or custom_order_by == ''">
            ORDER BY uns.create_time DESC
        </if>
    </select>

    <!-- 按用户查询所有通知渠道配置（核心业务快捷查询） -->
    <select id="selectByUserId" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_notify_setting uns
        WHERE uns.user_id = #{userId}
        ORDER BY uns.create_time DESC
    </select>

</mapper>