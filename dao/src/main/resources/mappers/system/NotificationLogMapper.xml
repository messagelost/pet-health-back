<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jacob.dao.mappers.system.NotificationLogDao">

    <!-- 基础结果映射：对应NotificationLog实体类所有字段 -->
    <resultMap id="BaseResultMap" type="com.jacob.common.model.system.entity.NotificationLog">
        <id property="logId" column="log_id"/>
        <result property="taskId" column="task_id"/>
        <result property="userId" column="user_id"/>
        <result property="notificationType" column="notification_type"/>
        <result property="channel" column="channel"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="sendTime" column="send_time"/>
        <result property="status" column="status"/>
        <result property="retryCount" column="retry_count"/>
        <result property="responseMsg" column="response_msg"/>
        <!-- 继承BaseEntity的公共字段 -->
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="updateUserId" column="update_user_id"/>
    </resultMap>

    <!-- 基础字段列表：用于查询语句复用 -->
    <sql id="Base_Column_List">
        nl.log_id,
        nl.task_id,
        nl.user_id,
        nl.notification_type,
        nl.channel,
        nl.title,
        nl.content,
        nl.send_time,
        nl.status,
        nl.retry_count,
        nl.response_msg,
        nl.create_time,
        nl.update_time,
        nl.create_user_id,
        nl.update_user_id
    </sql>

    <!-- 新增通知执行日志 -->
    <insert id="insertWithBean" parameterType="com.jacob.common.model.system.entity.NotificationLog">
        INSERT INTO notification_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="logId != null and logId != ''">
                log_id,
            </if>
            <if test="taskId != null and taskId != ''">
                task_id,
            </if>
            <if test="userId != null and userId != ''">
                user_id,
            </if>
            <if test="notificationType != null and notificationType != ''">
                notification_type,
            </if>
            <if test="channel != null and channel != ''">
                channel,
            </if>
            <if test="title != null and title != ''">
                title,
            </if>
            <if test="content != null and content != ''">
                content,
            </if>
            <if test="sendTime != null">
                send_time,
            </if>
            <if test="status != null">
                status,
            </if>
            <if test="retryCount != null">
                retry_count,
            </if>
            <if test="responseMsg != null and responseMsg != ''">
                response_msg,
            </if>
            create_time,
            update_time,
            <if test="createUserId != null and createUserId != ''">
                create_user_id,
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                update_user_id,
            </if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="logId != null and logId != ''">
                #{logId},
            </if>
            <if test="taskId != null and taskId != ''">
                #{taskId},
            </if>
            <if test="userId != null and userId != ''">
                #{userId},
            </if>
            <if test="notificationType != null and notificationType != ''">
                #{notificationType},
            </if>
            <if test="channel != null and channel != ''">
                #{channel},
            </if>
            <if test="title != null and title != ''">
                #{title},
            </if>
            <if test="content != null and content != ''">
                #{content},
            </if>
            <if test="sendTime != null">
                #{sendTime},
            </if>
            <if test="status != null">
                #{status},
            </if>
            <if test="retryCount != null">
                #{retryCount},
            </if>
            <if test="responseMsg != null and responseMsg != ''">
                #{responseMsg},
            </if>
            NOW(),
            NOW(),
            <if test="createUserId != null and createUserId != ''">
                #{createUserId},
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                #{updateUserId},
            </if>
        </trim>
    </insert>

    <!-- 更新通知执行日志（主要更新状态、重试次数、返回信息） -->
    <update id="updateWithBean" parameterType="com.jacob.common.model.system.entity.NotificationLog">
        UPDATE notification_log
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="retryCount != null">retry_count = #{retryCount},</if>
            <if test="responseMsg != null and responseMsg != ''">response_msg = #{responseMsg},</if>
            <if test="sendTime != null">send_time = #{sendTime},</if>
            update_time = NOW(),
            <if test="updateUserId != null and updateUserId != ''">update_user_id = #{updateUserId},</if>
        </set>
        WHERE log_id = #{logId}
    </update>

    <!-- 根据主键删除日志（日志一般不删除，仅保留逻辑） -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.String">
        DELETE FROM notification_log WHERE log_id = #{logId}
    </delete>

    <!-- 批量删除日志 -->
    <delete id="deleteBatchByPrimaryKeys" parameterType="java.lang.String">
        DELETE FROM notification_log
        WHERE log_id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 统计日志数量（带条件） -->
    <select id="getCount" resultType="java.lang.Integer" parameterType="java.util.Map">
        SELECT COUNT(1)
        FROM notification_log
        <where>
            <if test="taskId != null and taskId != ''">
                AND task_id = #{taskId}
            </if>
            <if test="userId != null and userId != ''">
                AND user_id = #{userId}
            </if>
            <if test="notificationType != null and notificationType != ''">
                AND notification_type LIKE CONCAT('%', #{notificationType}, '%')
            </if>
            <if test="channel != null and channel != ''">
                AND channel = #{channel}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="sendTimeStart != null">
                AND send_time >= #{sendTimeStart}
            </if>
            <if test="sendTimeEnd != null">
                AND send_time &lt;= #{sendTimeEnd}
            </if>
        </where>
    </select>

    <!-- 查询日志列表（带条件） -->
    <select id="selectAllList" resultMap="BaseResultMap" parameterType="java.util.Map">
        SELECT
        <include refid="Base_Column_List"/>
        FROM notification_log nl
        <where>
            <if test="taskId != null and taskId != ''">
                AND nl.task_id = #{taskId}
            </if>
            <if test="userId != null and userId != ''">
                AND nl.user_id = #{userId}
            </if>
            <if test="notificationType != null and notificationType != ''">
                AND nl.notification_type LIKE CONCAT('%', #{notificationType}, '%')
            </if>
            <if test="channel != null and channel != ''">
                AND nl.channel = #{channel}
            </if>
            <if test="status != null">
                AND nl.status = #{status}
            </if>
            <if test="sendTimeStart != null">
                AND nl.send_time >= #{sendTimeStart}
            </if>
            <if test="sendTimeEnd != null">
                AND nl.send_time &lt;= #{sendTimeEnd}
            </if>
        </where>
        ORDER BY nl.send_time DESC
    </select>

    <!-- 根据任务ID查询通知日志（核心业务查询） -->
    <select id="selectByTaskId" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT
        <include refid="Base_Column_List"/>
        FROM notification_log nl
        WHERE nl.task_id = #{taskId}
        ORDER BY nl.send_time DESC
    </select>

    <!-- 查询发送失败的日志（用于重试） -->
    <select id="selectFailLogs" resultMap="BaseResultMap" parameterType="java.util.Map">
        SELECT
        <include refid="Base_Column_List"/>
        FROM notification_log nl
        WHERE nl.status = 2
        AND nl.retry_count &lt; #{maxRetryCount}
        <if test="channel != null and channel != ''">
            AND nl.channel = #{channel}
        </if>
        ORDER BY nl.send_time ASC
    </select>

</mapper>