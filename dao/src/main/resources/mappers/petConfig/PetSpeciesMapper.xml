<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jacob.dao.mappers.petConfig.PetSpeciesDao">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.jacob.common.model.petConfig.entity.PetSpecies">
        <id property="speciesId" column="species_id"/>
        <result property="speciesName" column="species_name"/>
        <result property="description" column="description"/>
        <result property="icon" column="icon"/>
        <!-- 继承BaseEntity的公共字段 -->
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="updateUserId" column="update_user_id"/>
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        ps.species_id,
        ps.species_name,
        ps.description,
        ps.icon,
        ps.create_time,
        ps.update_time,
        ps.create_user_id,
        ps.update_user_id
    </sql>

    <!-- 新增宠物种类 -->
    <insert id="insertWithBean" parameterType="com.jacob.common.model.petConfig.entity.PetSpecies">
        INSERT
        INTO pet_species
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="speciesId != null and speciesId != ''">
                species_id,
            </if>
            <if test="speciesName != null and speciesName != ''">
                species_name,
            </if>
            <if test="description != null">
                description,
            </if>
            <if test="icon != null">
                icon,
            </if>
            create_time,
            update_time
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="speciesId != null and speciesId != ''">
                #{speciesId},
            </if>
            <if test="speciesName != null and speciesName != ''">
                #{speciesName},
            </if>
            <if test="description != null">
                #{description},
            </if>
            <if test="icon != null">
                #{icon},
            </if>
            NOW(),
            NOW()
        </trim>
    </insert>

    <!-- 更新宠物种类 -->
    <update id="updateWithBean" parameterType="com.jacob.common.model.petConfig.entity.PetSpecies">
        UPDATE pet_species
        <set>
            <if test="speciesName != null and speciesName != ''">species_name = #{speciesName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="icon != null">icon = #{icon},</if>
            update_time = NOW()
        </set>
        WHERE species_id = #{speciesId}
    </update>

    <!-- 根据主键删除 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.String">
        DELETE FROM pet_species WHERE species_id = #{speciesId}
    </delete>

    <!-- 批量删除 -->
    <delete id="deleteBatchByPrimaryKeys" parameterType="java.lang.String">
        DELETE FROM pet_species
        WHERE species_id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 统计数量 -->
    <select id="getCount" resultType="java.lang.Integer" parameterType="java.util.Map">
        SELECT COUNT(1)
        FROM pet_species
        <where>
            <if test="speciesName != null and speciesName != ''">
                AND species_name LIKE CONCAT('%', #{speciesName}, '%')
            </if>
        </where>
    </select>

    <!-- 查询所有列表（带条件） -->
    <select id="selectAllList" resultMap="BaseResultMap" parameterType="java.util.Map">
        SELECT
        <include refid="Base_Column_List"/>
        FROM pet_species ps
        <where>
            <if test="speciesName != null and speciesName != ''">
                AND ps.species_name LIKE CONCAT('%', #{speciesName}, '%')
            </if>
            <if test="icon != null and icon != ''">
                AND ps.icon LIKE CONCAT('%', #{icon}, '%')
            </if>
        </where>
        <if test="custom_order_by != null and custom_order_by != ''">
            ORDER BY ${custom_order_by}
        </if>
    </select>
</mapper>