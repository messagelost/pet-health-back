<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jacob.dao.mappers.petData.PetMedicationRecordDao">

    <!-- 基础结果映射：对应PetMedicationRecord实体类所有字段 -->
    <resultMap id="BaseResultMap" type="com.jacob.common.model.petData.entity.PetMedicationRecord">
