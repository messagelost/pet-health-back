<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jacob.dao.mappers.petData.PetWeightRecordDao">

    <!-- 基础结果映射：对应PetWeightRecord实体类所有字段 -->
    <resultMap id="BaseResultMap" type="com.jacob.common.model.petData.entity.PetWeightRecord">
        <id property="recordId" column="record_id"/>
        <result property="petId" column="pet_id"/>
        <result property="weight" column="weight"/>
        <result property="lifeStage" column="life_stage"/>
        <!-- 继承BaseEntity的公共字段 -->
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="updateUserId" column="update_user_id"/>
    </resultMap>

    <!-- 基础字段列表：用于查询语句复用 -->
    <sql id="Base_Column_List">
        pwr.record_id,
        pwr.pet_id,
        pwr.weight,
        pwr.life_stage,
        pwr.create_time,
        pwr.update_time,
        pwr.create_user_id,
        pwr.update_user_id
    </sql>

    <!-- 新增宠物体重记录 -->
    <insert id="insertWithBean" parameterType="com.jacob.common.model.petData.entity.PetWeightRecord">
        INSERT INTO pet_weight_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recordId != null and recordId != ''">
                record_id,
            </if>
            <if test="petId != null and petId != ''">
                pet_id,
            </if>
            <if test="weight != null">
                weight,
            </if>
            <if test="lifeStage != null and lifeStage != ''">
                life_stage,
            </if>
            create_time,
            update_time,
            <if test="createUserId != null and createUserId != ''">
                create_user_id,
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                update_user_id,
            </if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recordId != null and recordId != ''">
                #{recordId},
            </if>
            <if test="petId != null and petId != ''">
                #{petId},
            </if>
            <if test="weight != null">
                #{weight},
            </if>
            <if test="lifeStage != null and lifeStage != ''">
                #{lifeStage},
            </if>
            NOW(),
            NOW(),
            <if test="createUserId != null and createUserId != ''">
                #{createUserId},
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                #{updateUserId},
            </if>
        </trim>
    </insert>

    <!-- 更新宠物体重记录 -->
    <update id="updateWithBean" parameterType="com.jacob.common.model.petData.entity.PetWeightRecord">
        UPDATE pet_weight_record
        <set>
            <if test="petId != null and petId != ''">pet_id = #{petId},</if>
            <if test="weight != null">weight = #{weight},</if>
            <if test="lifeStage != null and lifeStage != ''">life_stage = #{lifeStage},</if>
            update_time = NOW(),
            <if test="updateUserId != null and updateUserId != ''">update_user_id = #{updateUserId},</if>
        </set>
        WHERE record_id = #{recordId}
    </update>

    <!-- 根据主键删除体重记录 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.String">
        DELETE FROM pet_weight_record WHERE record_id = #{recordId}
    </delete>

    <!-- 批量删除体重记录 -->
    <delete id="deleteBatchByPrimaryKeys" parameterType="java.lang.String">
        DELETE FROM pet_weight_record
        WHERE record_id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 统计体重记录数量（带条件） -->
    <select id="getCount" resultType="java.lang.Integer" parameterType="java.util.Map">
        SELECT COUNT(1)
        FROM pet_weight_record
        <where>
            <if test="petId != null and petId != ''">
                AND pet_id = #{petId}
            </if>
            <if test="lifeStage != null and lifeStage != ''">
                AND life_stage = #{lifeStage}
            </if>
            <if test="minWeight != null">
                AND weight >= #{minWeight}
            </if>
            <if test="maxWeight != null">
                AND weight &lt;= #{maxWeight}
            </if>
        </where>
    </select>

    <!-- 查询体重记录列表（带条件） -->
    <select id="selectAllList" resultMap="BaseResultMap" parameterType="java.util.Map">
        SELECT
        <include refid="Base_Column_List"/>
        FROM pet_weight_record pwr
        <where>
            <if test="petId != null and petId != ''">
                AND pwr.pet_id = #{petId}
            </if>
            <if test="lifeStage != null and lifeStage != ''">
                AND pwr.life_stage = #{lifeStage}
            </if>
            <if test="minWeight != null">
                AND pwr.weight >= #{minWeight}
            </if>
            <if test="maxWeight != null">
                AND pwr.weight &lt;= #{maxWeight}
            </if>
        </where>
        <if test="custom_order_by != null and custom_order_by != ''">
            ORDER BY ${custom_order_by}
        </if>
    </select>

    <!-- 根据宠物ID查询体重记录列表（常用快捷查询） -->
    <select id="selectByPetId" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT
        <include refid="Base_Column_List"/>
        FROM pet_weight_record pwr
        WHERE pwr.pet_id = #{petId}
        ORDER BY pwr.create_time DESC
    </select>

    <!-- 查询宠物最新一条体重记录（常用快捷查询） -->
    <select id="selectLatestByPetId" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT
        <include refid="Base_Column_List"/>
        FROM pet_weight_record pwr
        WHERE pwr.pet_id = #{petId}
        ORDER BY pwr.create_time DESC
        LIMIT 1
    </select>

</mapper>