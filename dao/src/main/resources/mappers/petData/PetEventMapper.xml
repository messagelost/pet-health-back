<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jacob.dao.mappers.petData.PetEventDao">

    <!-- 基础结果映射：对应PetEvent实体类所有字段 -->
    <resultMap id="BaseResultMap" type="com.jacob.common.model.petData.entity.PetEvent">
        <id property="eventId" column="event_id"/>
        <result property="userId" column="user_id"/>
        <result property="petId" column="pet_id"/>
        <result property="eventType" column="event_type"/>
        <result property="eventContent" column="event_content"/>
        <result property="appointmentTime" column="appointment_time"/>
        <result property="status" column="status"/>
        <!-- 继承BaseEntity的公共字段 -->
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="updateUserId" column="update_user_id"/>

        <result property="petName" column="pet_name"/>
    </resultMap>

    <!-- 基础字段列表：用于查询语句复用 -->
    <sql id="Base_Column_List">
        pe.event_id,
        pe.user_id,
        pe.pet_id,
        pe.event_type,
        pe.event_content,
        pe.appointment_time,
        pe.status,
        pe.create_time,
        pe.update_time,
        pe.create_user_id,
        pe.update_user_id
    </sql>

    <!-- 新增宠物预约 -->
    <insert id="insertWithBean" parameterType="com.jacob.common.model.petData.entity.PetEvent">
        INSERT INTO pet_event
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="eventId != null and eventId != ''">
                event_id,
            </if>
            <if test="userId != null and userId != ''">
                user_id,
            </if>
            <if test="petId != null and petId != ''">
                pet_id,
            </if>
            <if test="eventType != null">
                event_type,
            </if>
            <if test="eventContent != null and eventContent != ''">
                event_content,
            </if>
            <if test="appointmentTime != null">
                appointment_time,
            </if>
            <if test="status != null">
                status,
            </if>
            create_time,
            update_time,
            <if test="createUserId != null and createUserId != ''">
                create_user_id,
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                update_user_id,
            </if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="eventId != null and eventId != ''">
                #{eventId},
            </if>
            <if test="userId != null and userId != ''">
                #{userId},
            </if>
            <if test="petId != null and petId != ''">
                #{petId},
            </if>
            <if test="eventType != null">
                #{eventType},
            </if>
            <if test="eventContent != null and eventContent != ''">
                #{eventContent},
            </if>
            <if test="appointmentTime != null">
                #{appointmentTime},
            </if>
            <if test="status != null">
                #{status},
            </if>
            NOW(),
            NOW(),
            <if test="createUserId != null and createUserId != ''">
                #{createUserId},
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                #{updateUserId},
            </if>
        </trim>
    </insert>

    <!-- 更新宠物预约 -->
    <update id="updateWithBean" parameterType="com.jacob.common.model.petData.entity.PetEvent">
        UPDATE pet_event
        <set>
            <if test="userId != null and userId != ''">user_id = #{userId},</if>
            <if test="petId != null and petId != ''">pet_id = #{petId},</if>
            <if test="eventType != null">event_type = #{eventType},</if>
            <if test="eventContent != null and eventContent != ''">event_content = #{eventContent},</if>
            <if test="appointmentTime != null">appointment_time = #{appointmentTime},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW(),
            <if test="updateUserId != null and updateUserId != ''">update_user_id = #{updateUserId},</if>
        </set>
        WHERE event_id = #{eventId}
    </update>

    <!-- 根据主键删除宠物预约 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.String">
        DELETE FROM pet_event WHERE event_id = #{eventId}
    </delete>

    <!-- 批量删除宠物预约 -->
    <delete id="deleteBatchByPrimaryKeys" parameterType="java.lang.String">
        DELETE FROM pet_event
        WHERE event_id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 统计预约数量 -->
    <select id="getCount" resultType="java.lang.Integer" parameterType="java.util.Map">
        SELECT COUNT(1)
        FROM pet_event
        <where>
            <if test="userId != null and userId != ''">
                AND user_id = #{userId}
            </if>
            <if test="petId != null and petId != ''">
                AND pet_id = #{petId}
            </if>
            <if test="eventType != null">
                AND event_type = #{eventType}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <!-- 预约时间精准查询 -->
            <if test="appointmentTime != null">
                AND appointment_time = #{appointmentTime}
            </if>
            <!-- 预约时间范围查询：开始时间 -->
            <if test="startTime != null">
                AND appointment_time >= #{startTime}
            </if>
            <!-- 预约时间范围查询：结束时间 -->
            <if test="endTime != null">
                AND appointment_time &lt;= #{endTime}
            </if>
        </where>
    </select>

    <!-- 查询宠物预约列表（带条件） -->
    <select id="selectAllList" resultMap="BaseResultMap" parameterType="java.util.Map">
        SELECT
        <include refid="Base_Column_List"/>,
        p.pet_name
        FROM pet_event pe
        LEFT JOIN pet_basic_info p ON pe.pet_id = p.pet_id
        <where>
            <if test="userId != null and userId != ''">
                AND pe.user_id = #{userId}
            </if>
            <if test="petId != null and petId != ''">
                AND pe.pet_id = #{petId}
            </if>
            <if test="eventType != null">
                AND pe.event_type = #{eventType}
            </if>
            <if test="status != null">
                AND pe.status = #{status}
            </if>
            <!-- 预约时间精准查询 -->
            <if test="appointmentTime != null">
                AND pe.appointment_time = #{appointmentTime}
            </if>
            <!-- 预约时间范围查询：开始时间 -->
            <if test="startTime != null">
                AND pe.appointment_time >= #{startTime}
            </if>
            <!-- 预约时间范围查询：结束时间 -->
            <if test="endTime != null">
                AND pe.appointment_time &lt;= #{endTime}
            </if>
        </where>
        <if test="custom_order_by != null and custom_order_by != ''">
            ORDER BY ${custom_order_by}
        </if>
        <!-- 默认按预约时间升序+创建时间降序 -->
        <if test="custom_order_by == null or custom_order_by == ''">
            ORDER BY pe.appointment_time ASC, pe.create_time DESC
        </if>
    </select>

    <!-- 按用户+状态查询预约（核心业务快捷查询） -->
    <select id="selectByUserAndStatus" resultMap="BaseResultMap" parameterType="java.util.Map">
        SELECT
        <include refid="Base_Column_List"/>
        FROM pet_event pe
        WHERE pe.user_id = #{userId}
        AND pe.status = #{status}
        ORDER BY pe.appointment_time ASC
    </select>

</mapper>