                #{createUserId},
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                #{updateUserId},
            </if>
        </trim>
    </insert>

    <!-- 更新宠物营养摄入记录 -->
    <update id="updateWithBean" parameterType="com.jacob.common.model.petData.entity.PetNutritionIntake">
        UPDATE pet_nutrition_intake
        <set>
            <if test="petId != null and petId != ''">pet_id = #{petId},</if>
            <if test="intakeDate != null">intake_date = #{intakeDate},</if>
            <if test="foodType != null">food_type = #{foodType},</if>
            <if test="nutritionJson != null and nutritionJson != ''">nutrition_json = #{nutritionJson},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            update_time = NOW(),
            <if test="updateUserId != null and updateUserId != ''">update_user_id = #{updateUserId},</if>
        </set>
        WHERE intake_id = #{intakeId}
    </update>

    <!-- 根据主键删除营养摄入记录 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.String">
        DELETE FROM pet_nutrition_intake WHERE intake_id = #{intakeId}
    </delete>

    <!-- 批量删除营养摄入记录 -->
    <delete id="deleteBatchByPrimaryKeys" parameterType="java.lang.String">
        DELETE FROM pet_nutrition_intake
        WHERE intake_id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 统计营养摄入记录数量（带条件） -->
    <select id="getCount" resultType="java.lang.Integer" parameterType="java.util.Map">
        SELECT COUNT(1)
        FROM pet_nutrition_intake
        <where>
            <if test="petId != null and petId != ''">
                AND pet_id = #{petId}
            </if>
            <if test="foodType != null">
                AND food_type = #{foodType}
            </if>
            <if test="intakeDateStart != null">
                AND intake_date >= #{intakeDateStart}
            </if>
            <if test="intakeDateEnd != null">
                AND intake_date &lt;= #{intakeDateEnd}
            </if>
        </where>
    </select>

    <!-- 查询营养摄入记录列表（带条件） -->
    <select id="selectAllList" resultMap="BaseResultMap" parameterType="java.util.Map">
        SELECT
        <include refid="Base_Column_List"/>
        FROM pet_nutrition_intake pni
        <where>
            <if test="petId != null and petId != ''">
                AND pni.pet_id = #{petId}
            </if>
            <if test="foodType != null">
                AND pni.food_type = #{foodType}
            </if>
            <if test="intakeDateStart != null">
                AND pni.intake_date >= #{intakeDateStart}
            </if>
            <if test="intakeDateEnd != null">
                AND pni.intake_date &lt;= #{intakeDateEnd}
            </if>
        </where>
        <if test="custom_order_by != null and custom_order_by != ''">
