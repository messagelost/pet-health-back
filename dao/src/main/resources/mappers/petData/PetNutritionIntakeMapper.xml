    <!-- 新增宠物营养摄入记录 -->
    <insert id="insertWithBean" parameterType="com.jacob.common.model.petData.entity.PetNutritionIntake">
        INSERT INTO pet_nutrition_intake
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="intakeId != null and intakeId != ''">
                intake_id,
            </if>
            <if test="petId != null and petId != ''">
                pet_id,
            </if>
            <if test="intakeDate != null">
                intake_date,
            </if>
            <if test="foodType != null">
                food_type,
            </if>
            <if test="nutritionJson != null and nutritionJson != ''">
                nutrition_json,
            </if>
            <if test="remark != null and remark != ''">
                remark,
            </if>
            create_time,
            update_time,
            <if test="createUserId != null and createUserId != ''">
                create_user_id,
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                update_user_id,
            </if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="intakeId != null and intakeId != ''">
                #{intakeId},
            </if>
            <if test="petId != null and petId != ''">
                #{petId},
            </if>
            <if test="intakeDate != null">
                #{intakeDate},
            </if>
            <if test="foodType != null">
                #{foodType},
