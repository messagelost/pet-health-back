    <select id="selectByPetId" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT
        <include refid="Base_Column_List"/>
        FROM pet_nutrition_intake pni
        WHERE pni.pet_id = #{petId}
        ORDER BY pni.intake_date DESC
    </select>

    <!-- 根据食物类型查询记录列表（常用快捷查询） -->
    <select id="selectByFoodType" resultMap="BaseResultMap" parameterType="java.lang.Integer">
        SELECT
        <include refid="Base_Column_List"/>
        FROM pet_nutrition_intake pni
        WHERE pni.food_type = #{foodType}
        ORDER BY pni.intake_date DESC
    </select>

