    <update id="updateWithBean" parameterType="com.jacob.common.model.petData.entity.PetGroomingRecord">
        UPDATE pet_grooming_record
        <set>
            <if test="petId != null and petId != ''">pet_id = #{petId},</if>
            <if test="typeId != null and typeId != ''">type_id = #{typeId},</if>
            <if test="groomingDate != null">grooming_date = #{groomingDate},</if>
            <if test="serviceProviderType != null">service_provider_type = #{serviceProviderType},</if>
            <if test="serviceProviderName != null and serviceProviderName != ''">service_provider_name = #{serviceProviderName},</if>
            <if test="totalCost != null">total_cost = #{totalCost},</if>
            <if test="photosBefore != null and photosBefore != ''">photos_before = #{photosBefore},</if>
            <if test="photosAfter != null and photosAfter != ''">photos_after = #{photosAfter},</if>
