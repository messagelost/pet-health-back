            update_time = NOW(),
            <if test="updateUserId != null and updateUserId != ''">update_user_id = #{updateUserId},</if>
        </set>
        WHERE record_id = #{recordId}
    </update>

    <!-- 根据主键删除洗护记录 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.String">
        DELETE FROM pet_grooming_record WHERE record_id = #{recordId}
    </delete>

    <!-- 批量删除洗护记录 -->
    <delete id="deleteBatchByPrimaryKeys" parameterType="java.lang.String">
        DELETE FROM pet_grooming_record
        WHERE record_id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 统计洗护记录数量（带条件） -->
    <select id="getCount" resultType="java.lang.Integer" parameterType="java.util.Map">
        SELECT COUNT(1)
        FROM pet_grooming_record
        <where>
            <if test="petId != null and petId != ''">
                AND pet_id = #{petId}
            </if>
            <if test="typeId != null and typeId != ''">
                AND type_id = #{typeId}
            </if>
            <if test="serviceProviderType != null">
                AND service_provider_type = #{serviceProviderType}
            </if>
            <if test="groomingDateStart != null">
                AND grooming_date >= #{groomingDateStart}
            </if>
            <if test="groomingDateEnd != null">
                AND grooming_date &lt;= #{groomingDateEnd}
            </if>
            <if test="serviceProviderName != null and serviceProviderName != ''">
                AND service_provider_name LIKE CONCAT('%', #{serviceProviderName}, '%')
            </if>
        </where>
    </select>

